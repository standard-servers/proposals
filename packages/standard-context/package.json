{
	"name": "standard-context",
	"version": "0.0.5",
	"description": "Standard Context for JavaScript Servers",
	"license": "MIT",
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "obuild",
		"check": "tsc --noEmit",
		"format": "pnpm readme && oxfmt",
		"readme": "node scripts/readme.ts"
	},
	"devDependencies": {
		"obuild": "^0.4.45",
		"oxfmt": "^0.74.0",
		"typescript": "^5.9.3"
	},
	"packageManager": "pnpm@12.15.0"
}
