{
	"name": "standard-context",
	"description": "Standard Context for JavaScript Servers",
	"version": "0.0.3",
	"license": "MIT",
	"type": "module",
	"types": "./dist/index.d.ts",
	"main": "./dist/index.js",
	"exports": {
		"./package.json": {
			"default": "./package.json"
		},
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"./dist/index.js",
		"./dist/index.d.ts",
		"./dist/index.d.ts.map",
		"./src/index.ts"
	],
	"scripts": {
		"check": "tsc --noEmit",
		"dev": "tsc --watch",
		"build": "tsc",
		"format": "prettier --write .",
		"example": "bun run build && bun dist/example"
	},
	"devDependencies": {
		"@robino/prettier": "^2.0.2",
		"@robino/tsconfig": "^1.1.0",
		"prettier": "^3.6.2",
		"typescript": "^5.9.3"
	}
}
