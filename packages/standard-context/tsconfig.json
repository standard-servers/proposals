{
	"compilerOptions": {
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"lib": ["ESNext", "DOM"],
		"strict": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"exactOptionalPropertyTypes": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noEmit": true
	},
	"include": ["src", "*.mjs"]
}
