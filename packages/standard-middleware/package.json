{
	"name": "standard-middleware",
	"description": "Standard Middleware for JavaScript Servers.",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"types": "./dist/index.d.ts",
	"main": "./dist/index.js",
	"exports": {
		"./package.json": {
			"default": "./package.json"
		},
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"./dist/index.js",
		"./dist/index.d.ts",
		"./dist/index.d.ts.map",
		"./src/index.ts"
	],
	"scripts": {
		"check": "tsc --noEmit",
		"dev": "tsc --watch",
		"build": "tsc",
		"example": "bun run build && bun dist/example"
	},
	"devDependencies": {
		"@robino/tsconfig": "^1.1.0"
	},
	"dependencies": {
		"standard-context": "^0.0.1"
	}
}
